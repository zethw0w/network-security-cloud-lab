{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarSomenteOLabBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::lab-bucket"]
    },
    {
      "Sid": "LerEGravarObjetosDoLabBucket",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::lab-bucket/*"]
    }
  ]
}
